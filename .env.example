# Copiez ce fichier en .env.local et remplissez les valeurs (jamais commité).
# En production, ces variables se configurent dans le dashboard Netlify
# (Site settings > Environment variables), pas ici.

# API Pexels — utilisée côté serveur uniquement (Netlify Function)
PEXELS_API_KEY=your_pexels_api_key_here

# Notifications Telegram — utilisées par netlify/functions/send-telegram.js
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
